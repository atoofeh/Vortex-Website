# Gmail account used by the assessment form to send notifications.
# Use a Google App Password, not the normal mailbox password.
GMAIL_USER=contact@vortexmind.co
GMAIL_APP_PASSWORD=

# Inbox that receives new assessment requests.
CONTACT_EMAIL=contact@vortexmind.co
NEXT_PUBLIC_CRUNCHBASE_URL=
