NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
NEXT_PUBLIC_OFFICIAL_REGISTRY_URL=
NEXT_PUBLIC_FOUNDER_NAME=
NEXT_PUBLIC_FOUNDER_URL=
NEXT_PUBLIC_FOUNDER_ALUMNI_OF=

# Optional Search Console HTML verification token (not needed for DNS verification).
GOOGLE_SITE_VERIFICATION=
